{
  "name": "ccu",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:linux": "cargo tauri build --bundles appimage,deb",
    "build:win": "cargo tauri build --target x86_64-pc-windows-msvc --bundles portable",
    "test:clinton": "node tests/clinton/build-test.mjs && node tests/workspace_guard.test.mjs && node tests/clinton/agent.test.mjs && node tests/clinton/ai_reliability.test.mjs",
    "test:workspace": "node tests/workspace_guard.test.mjs",
    "test:licensing": "node tests/licensing.test.mjs",
    "test:activation-deno": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run --unstable-kv activation/deno/server_test.ts",
    "test:keygen": "cargo test --manifest-path tools/keygen/Cargo.toml && node tools/keygen/scripts/e2e.mjs",
    "test:keygen-deno": "CCU_E2E_SERVER=deno node tools/keygen/scripts/e2e.mjs",
    "measure:ai": "node tests/clinton/build-test.mjs && node tests/clinton/measure.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^6.0.0"
  }
}
